generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("USER")
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals        Deal[]
  favorites    Favorite[]
  vouchers     Voucher[]
  reviews      Review[]
  widgets      Widget[]
  sources      Source[]
  subscription Subscription?
  usage        Usage[]
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  deals     Deal[]
}

model Deal {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  highlights    String   @default("[]")
  imageUrl      String
  originalPrice Float
  dealPrice     Float
  city          String
  location      String
  stock         Int      @default(50)
  soldCount     Int      @default(0)
  validUntil    DateTime
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  categoryId    String
  merchantId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  merchant  User       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  vouchers  Voucher[]
  reviews   Review[]

  @@index([city])
  @@index([categoryId])
  @@index([featured])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  dealId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId])
}

model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  status      String    @default("ACTIVE")
  quantity    Int       @default(1)
  totalPaid   Float
  userId      String
  dealId      String
  purchasedAt DateTime  @default(now())
  redeemedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Restrict)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  userId    String
  dealId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId])
}

model Widget {
  id           String   @id @default(cuid())
  // Public key goes in the embed snippet. The widget id stays private so a
  // leaked key cannot be used against the authenticated API.
  publicKey    String   @unique
  placeId      String
  placeName    String
  placeAddress String?
  userId       String
  settings     Json?    @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources Source[]
  stats   WidgetStat[]

  @@index([userId])
}

/// One row per widget per day (UTC) for the owner's analytics page. The
/// monthly count the plan limit is checked against lives in Usage.
model WidgetStat {
  id       String @id @default(cuid())
  widgetId String
  /// YYYY-MM-DD in UTC.
  day      String
  /// Shown and counted towards the plan: once per visitor per 30 minutes.
  views    Int    @default(0)
  /// Every time the widget was shown, reloads included.
  loads    Int    @default(0)
  /// Clicks on "Write a review" and "See all reviews".
  clicks   Int    @default(0)
  /// Visitors who got nothing because the monthly limit was used up.
  missed   Int    @default(0)

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([widgetId, day])
}

/// A domain the user is allowed to embed a widget on. The public endpoint
/// checks the request's Origin against these, so a copied snippet does not
/// work anywhere else.
model Source {
  id        String    @id @default(cuid())
  domain    String
  userId    String
  widgetId  String?
  createdAt DateTime  @default(now())
  lastSeen  DateTime?
  hits      Int       @default(0)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Deleting a widget keeps the domain (it becomes account-wide) - the user
  // registered that site on purpose.
  widget Widget? @relation(fields: [widgetId], references: [id], onDelete: SetNull)

  @@unique([userId, domain])
  @@index([widgetId])
  @@index([domain])
}

/// One per user. Created lazily on the FREE plan, so existing accounts need no backfill.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  /// FREE | PRO | BUSINESS - see src/billing/plans.ts
  plan                 String    @default("FREE")
  /// ACTIVE | PENDING | CANCELLED | SUSPENDED | EXPIRED
  status               String    @default("ACTIVE")
  paypalSubscriptionId String?   @unique
  /// Plan the user is checking out for, until PayPal confirms it.
  pendingPlan          String?
  currentPeriodEnd     DateTime?
  /// Cancelled on PayPal, but paid up until currentPeriodEnd.
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Widget views per user per calendar month ("2026-09").
model Usage {
  id        String  @id @default(cuid())
  userId    String
  period    String
  views     Int     @default(0)
  warned80  Boolean @default(false)
  warned100 Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}

/// Every PayPal webhook we have processed, keyed by PayPal's event id so a
/// redelivered event is recognised and skipped.
model BillingEvent {
  id        String   @id
  type      String
  userId    String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Plans live in the database so the super admin can change prices and limits
/// without a deploy. `key` is what Subscription.plan stores.
model BillingPlan {
  key                 String   @id
  name                String
  priceUsd            Float    @default(0)
  sources             Int      @default(1)
  widgets             Int      @default(1)
  reviews             Int      @default(3)
  /// null = unlimited
  views               Int?
  /// Hours between automatic review refreshes. null = the default for the
  /// plan's key (FREE 48, PRO 24, BUSINESS 12), so existing rows need no backfill.
  refreshHours        Int?
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  /// PayPal keeps its own copy of each paid plan, one per environment.
  paypalPlanIdSandbox String?
  paypalPlanIdLive    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Runtime settings edited from the admin panel (PayPal keys, mode, ...).
/// Secret values are stored encrypted - see SettingsService.
model AppSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
