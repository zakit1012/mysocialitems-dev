generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("USER")
  city          String?
  /// Bumped when the password changes: older sign-ins stop working.
  tokenVersion  Int       @default(0)
  /// Admin 2-step sign-in (authenticator app): the secret, encrypted with
  /// SETTINGS_SECRET. Pending until totpEnabledAt is set.
  totpSecret    String?
  totpEnabledAt DateTime?
  /// The last 30-second step used, so each code works only once.
  totpLastStep  Int?
  /// A developer account, set in Admin -> Users: its checkouts go to Dodo's
  /// test mode (sandbox, no real money) whatever the site-wide mode is.
  testPayments  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deals        Deal[]
  favorites    Favorite[]
  vouchers     Voucher[]
  reviews      Review[]
  widgets      Widget[]
  businesses   Business[]
  sources      Source[]
  subscription Subscription?
  usage        Usage[]
  payments     Payment[]
}

/// Category, Deal, Favorite, Voucher and Review belong to the old deals app.
/// No code uses them any more; the tables stay so that existing rows are not
/// dropped by the next `prisma db push`.
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  deals     Deal[]
}

model Deal {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  highlights    String   @default("[]")
  imageUrl      String
  originalPrice Float
  dealPrice     Float
  city          String
  location      String
  stock         Int      @default(50)
  soldCount     Int      @default(0)
  validUntil    DateTime
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  categoryId    String
  merchantId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  merchant  User       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  vouchers  Voucher[]
  reviews   Review[]

  @@index([city])
  @@index([categoryId])
  @@index([featured])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  dealId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId])
}

model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  status      String    @default("ACTIVE")
  quantity    Int       @default(1)
  totalPaid   Float
  userId      String
  dealId      String
  purchasedAt DateTime  @default(now())
  redeemedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Restrict)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  userId    String
  dealId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId])
}

model Widget {
  id           String    @id @default(cuid())
  // Public key goes in the embed snippet. The widget id stays private so a
  // leaked key cannot be used against the authenticated API.
  publicKey    String    @unique
  placeId      String
  placeName    String
  placeAddress String?
  userId       String
  settings     Json?     @default("{}")
  /// The last time a visitor's page loaded this widget, and on which site.
  /// Shown to the owner as "installed and live".
  lastSeenAt   DateTime?
  lastSeenHost String?
  /// Legacy (the poster logo now lives on Business, copied from here when
  /// the business is first listed). Kept so existing rows are not dropped.
  logo         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources Source[]
  stats   WidgetStat[]

  @@index([userId])
}

/// One row per widget per day (UTC) for the owner's analytics page. The
/// monthly count the plan limit is checked against lives in Usage.
model WidgetStat {
  id       String @id @default(cuid())
  widgetId String
  /// YYYY-MM-DD in UTC.
  day      String
  /// Shown and counted towards the plan: once per visitor per 30 minutes.
  views    Int    @default(0)
  /// Every time the widget was shown, reloads included.
  loads    Int    @default(0)
  /// Clicks on "Write a review" and "See all reviews".
  clicks   Int    @default(0)
  /// Visitors who got nothing because the monthly limit was used up.
  missed   Int    @default(0)

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([widgetId, day])
}

/// A domain the user is allowed to embed a widget on. The public endpoint
/// checks the request's Origin against these, so a copied snippet does not
/// work anywhere else.
model Source {
  id        String    @id @default(cuid())
  domain    String
  userId    String
  widgetId  String?
  createdAt DateTime  @default(now())
  lastSeen  DateTime?
  hits      Int       @default(0)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Deleting a widget keeps the domain (it becomes account-wide) - the user
  // registered that site on purpose.
  widget Widget? @relation(fields: [widgetId], references: [id], onDelete: SetNull)

  @@unique([userId, domain])
  @@index([widgetId])
  @@index([domain])
}

/// One per user. Created lazily on the FREE plan, so existing accounts need no backfill.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  /// FREE | PRO | BUSINESS - see src/billing/plans.ts
  plan                 String    @default("FREE")
  /// ACTIVE | PAST_DUE | CANCELLED | SUSPENDED | EXPIRED
  status               String    @default("ACTIVE")
  /// Dodo Payments subscription (sub_...) and customer (cus_...).
  dodoSubscriptionId   String?
  dodoCustomerId       String?
  /// test | live - the Dodo mode dodoSubscriptionId lives in, so cancel,
  /// resume and plan changes reach it there. Null (older rows): the
  /// site-wide mode.
  dodoMode             String?
  /// USD or INR - the currency the customer is billed in.
  currency             String?
  /// Legacy (PayPal, no longer used).
  paypalSubscriptionId String?   @unique
  /// Plan the user is checking out for, until the payment confirms it.
  pendingPlan          String?
  currentPeriodEnd     DateTime?
  /// Cancelled, but paid up until currentPeriodEnd.
  cancelAtPeriodEnd    Boolean   @default(false)
  /// An upgrade starts at once, before its difference is paid: the plan it
  /// came from and when. If that charge fails (upgradeUnpaid), the account
  /// has upgradeFrom's limits - what was paid for - until a payment goes
  /// through. Cleared by the next successful payment.
  upgradeFrom          String?
  upgradeAt            DateTime?
  upgradeUnpaid        Boolean   @default(false)
  /// month | year
  interval             String    @default("month")
  /// Printed on invoices under "Billed to" (all optional).
  billingName          String?
  billingAddress       String?
  billingTaxId         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dodoSubscriptionId])
}

/// Every payment collected, one row per charge. `number` is our reference
/// (WPOP-00042), given in order of payment.
model Payment {
  id                   String    @id @default(cuid())
  number               Int       @unique @default(autoincrement())
  /// Kept (as null) if the account is deleted: the books still need it.
  userId               String?
  /// Dodo's payment id. Unique, so a repeated webhook adds nothing.
  dodoPaymentId        String?
  dodoSubscriptionId   String?
  /// Dodo's invoice PDF: Dodo sells as merchant of record, so this is the
  /// customer's legal invoice.
  invoiceUrl           String?
  /// What reaches our Dodo balance, in its currency (USD), after fees.
  settlementCents      Int?
  settlementCurrency   String?
  /// Legacy (PayPal, no longer used).
  paypalSaleId         String?   @unique
  paypalSubscriptionId String?
  /// test | live (sandbox = legacy PayPal tests) - only live rows are revenue.
  mode                 String    @default("live")
  plan                 String
  planName             String
  /// month | year
  interval             String    @default("month")
  amountCents          Int
  currency             String    @default("USD")
  /// Processing fee, where known. Admin only.
  feeCents             Int?
  refundedCents        Int       @default(0)
  /// PAID | PARTIALLY_REFUNDED | REFUNDED | REVERSED
  status               String    @default("PAID")
  periodStart          DateTime
  periodEnd            DateTime?
  /// Who paid, as it was then - still readable if the account goes.
  customerName         String
  customerEmail        String
  paidAt               DateTime  @default(now())
  createdAt            DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, paidAt])
  @@index([paidAt])
  @@index([dodoPaymentId])
}

/// Widget views per user per calendar month ("2026-09").
model Usage {
  id        String  @id @default(cuid())
  userId    String
  period    String
  views     Int     @default(0)
  warned80  Boolean @default(false)
  warned100 Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}

/// Every PayPal webhook we have processed, keyed by PayPal's event id so a
/// redelivered event is recognised and skipped.
model BillingEvent {
  id        String   @id
  type      String
  userId    String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Plans live in the database so the super admin can change prices and limits
/// without a deploy. `key` is what Subscription.plan stores.
model BillingPlan {
  key                   String   @id
  name                  String
  priceUsd              Float    @default(0)
  sources               Int      @default(1)
  widgets               Int      @default(1)
  reviews               Int      @default(3)
  /// null = unlimited
  views                 Int?
  /// Hours between automatic review refreshes. null = the default for the
  /// plan's key (FREE 48, PRO 24, BUSINESS 12), so existing rows need no backfill.
  refreshHours          Int?
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)
  /// Yearly billing. null price = 10x the monthly price (two months free).
  priceYearlyUsd        Float?
  /// Legacy (rupee prices, no longer used: Dodo converts the dollar price
  /// for customers in India). Kept so existing rows are not dropped.
  priceInr              Float?
  priceYearlyInr        Float?
  /// Dodo Payments keeps each paid plan as a product: one per mode and period.
  dodoMonthlyIdTest     String?
  dodoMonthlyIdLive     String?
  dodoYearlyIdTest      String?
  dodoYearlyIdLive      String?
  /// Legacy (rupee products, no longer used). Kept so existing rows are
  /// not dropped.
  dodoMonthlyInrIdTest  String?
  dodoMonthlyInrIdLive  String?
  dodoYearlyInrIdTest   String?
  dodoYearlyInrIdLive   String?
  /// Legacy (PayPal, no longer used). Kept so existing rows are not dropped.
  paypalPlanIdSandbox   String?
  paypalPlanIdLive      String?
  paypalYearlyIdSandbox String?
  paypalYearlyIdLive    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Runtime settings edited from the admin panel (payment keys, mode, ...).
/// Secret values are stored encrypted - see SettingsService.
model AppSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// A review kept out of every widget for its place, because the reviewer asked
/// us to stop showing it. Matched on the author and the start of the text:
/// the scraper does not always give a review id.
model HiddenReview {
  id        String   @id @default(cuid())
  placeId   String
  author    String
  /// Empty = every review by this author for the place.
  textStart String   @default("")
  note      String?
  createdAt DateTime @default(now())

  @@unique([placeId, author, textStart])
  @@index([placeId])
}

/// Every email the app tried to send, for the admin panel's email log: to
/// whom, what it said, and what the mail server answered. Never the code
/// itself: it is masked in the preview. Rows older than 30 days are removed.
model EmailLog {
  id        String    @id @default(cuid())
  to        String
  subject   String
  /// The plain-text body, codes masked. Null for rows logged before it was kept.
  preview   String?
  /// login, signup, email (change of address), notice or test
  kind      String
  /// SENT, FAILED, SKIPPED when SMTP is not set up, or BOUNCED when the
  /// receiving server (Gmail, ...) refused it after our mail server took it
  status    String
  error     String?
  /// Our Message-ID (<wpop-...@domain>): how a bounce report finds its email.
  messageId String?
  bouncedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([messageId])
}

/// A Google business an account shows reviews for - one row however many of
/// its widgets show it. It keeps what the review tools (Get reviews) need:
/// the poster logo and colour, and the short review link printed in QR codes.
model Business {
  id          String   @id @default(cuid())
  userId      String
  placeId     String
  placeName   String
  /// Poster logo: a small image data URL, resized in the browser.
  logo        String?
  /// Poster colour, e.g. #e8446d; null = the default.
  posterColor String?
  /// widgetpop.com/r/<slug> opens the business's Google review form. It is
  /// printed in QR codes, so it never changes.
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  opens ReviewLinkOpen[]

  @@unique([userId, placeId])
}

/// How often a business's short review link was opened, per day (UTC,
/// "2026-09-28", as WidgetStat keeps it).
model ReviewLinkOpen {
  businessId String
  day        String
  opens      Int    @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, day])
}
