PORT=3001
NODE_ENV=development

# Comma separated. Required in production - used for CORS.
FRONTEND_URL=http://localhost:3002

# Required in production: 32+ random characters. The app refuses to start
# with a default or short value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Set to true when running behind nginx or another reverse proxy, otherwise
# rate limiting sees every visitor as the proxy and throttles them together.
TRUST_PROXY=false

# Postgres
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/socialdeal

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Where reviews come from. Run your own, or point at a hosted one.
# See https://github.com/zakit1012/review_engine
REVIEW_ENGINE_URL=https://reviewengine.zedcircle.com

# Google Places (New) - used for the place autocomplete when creating a widget.
# The legacy Places API is not enough; enable "Places API (New)".
GOOGLE_PLACES_API_KEY=

# SMTP for login codes and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=My Social Items <noreply@example.com>

# PayPal billing is configured in the app: Admin -> PayPal (sandbox and live
# keys, mode switch) and Admin -> Plans ("Create in PayPal"). Keys saved there
# are encrypted with SETTINGS_SECRET - set it once and never change it.
SETTINGS_SECRET=
# Public URL of this API, shown in the admin panel as the webhook address.
PUBLIC_API_URL=http://localhost:3001
