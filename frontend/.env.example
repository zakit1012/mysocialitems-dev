# Where each part of the site lives. Leave APP_URL and ADMIN_URL empty in
# development: everything is then served from localhost:3002. In production
# one Next.js server answers all three hosts and sends each page to its own:
#   NEXT_PUBLIC_SITE_URL=https://widgetpop.com          home, pricing, legal
#   NEXT_PUBLIC_APP_URL=https://app.widgetpop.com       sign in, dashboard
#   NEXT_PUBLIC_ADMIN_URL=https://admin.widgetpop.com   admin panel
# These are built into the pages: rebuild after changing them.
NEXT_PUBLIC_SITE_URL=https://widgetpop.com
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ADMIN_URL=

# Public URL of the backend API.
# In production this MUST be the public https address - it is baked into the
# embed snippet customers paste on their sites, so localhost would break them.
# Production: NEXT_PUBLIC_API_URL=https://api.widgetpop.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Browser key for the place search (Maps JavaScript API). This one IS public:
# it is inlined into the page, so it must be a separate key from the
# backend's GOOGLE_PLACES_API_KEY. In Google Cloud restrict it to
#   - Websites: https://app.widgetpop.com/*, https://widgetpop.com/*
#     and http://localhost:3002/*
#   - APIs: Maps JavaScript API and Places API (New) only
# and put a daily quota cap on it. Leave empty to search through the backend.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
