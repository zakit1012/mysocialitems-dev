PORT=3001
FRONTEND_URL=http://localhost:3002
JWT_SECRET=change-me

# Postgres
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/socialdeal

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Where reviews come from. Run your own, or point at a hosted one.
# See https://github.com/zakit1012/review_engine
REVIEW_ENGINE_URL=https://reviewengine.zedcircle.com

# Google Places (New) - used for the place autocomplete when creating a widget.
# The legacy Places API is not enough; enable "Places API (New)".
GOOGLE_PLACES_API_KEY=

# SMTP for login codes and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=My Social Items <noreply@example.com>
