PORT=3001
NODE_ENV=development

# Comma separated. Required in production - the websites allowed to call
# this API (CORS). SITE_URL, APP_URL and ADMIN_URL below are allowed too.
# Production: FRONTEND_URL=https://widgetpop.com
FRONTEND_URL=http://localhost:3002

# Production only; leave empty in development (then FRONTEND_URL is used).
# SITE_URL: the marketing site - "Powered by" links, the logo in emails.
# APP_URL: where customers sign in - dashboard, billing and invoice links.
# ADMIN_URL: the admin panel.
# SITE_URL=https://widgetpop.com
# APP_URL=https://app.widgetpop.com
# ADMIN_URL=https://admin.widgetpop.com
SITE_URL=
APP_URL=
ADMIN_URL=

# Required in production: 32+ random characters. The app refuses to start
# with a default or short value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Set to true when running behind nginx or another reverse proxy, otherwise
# rate limiting sees every visitor as the proxy and throttles them together.
TRUST_PROXY=false

# Postgres
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/widgetpop

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Where reviews come from. Run your own, or point at a hosted one.
# See https://github.com/zakit1012/review_engine
# On a dev machine point this at a local engine (http://localhost:8000):
# test places and previews sent to the live engine are scraped for real.
REVIEW_ENGINE_URL=https://reviewengine.zedcircle.com

# Google Places (New) - used for the place autocomplete when creating a widget.
# The legacy Places API is not enough; enable "Places API (New)".
GOOGLE_PLACES_API_KEY=

# SMTP for login codes and notifications. Port 587 = STARTTLS, 465 = SSL.
# One NAME=value per line (not "SMTP Host: ..." as a mail panel shows it).
# Keep the password in double quotes: an unquoted # starts a comment.
# SMTP_FROM must be the same mailbox as SMTP_USER (most mail servers refuse
# any other sender); leave it out to send as SMTP_USER. The server log says
# "SMTP ready" or "SMTP check failed: <reason>" at start-up.
SMTP_HOST=mail.widgetpop.com
SMTP_PORT=587
SMTP_USER=support@widgetpop.com
SMTP_PASS="your mailbox password"
SMTP_FROM="WidgetPop <support@widgetpop.com>"
# Emails that Gmail and others refuse after our mail server took them come
# back to SMTP_USER's inbox; it is read over IMAP (port 993, same login) to
# mark them Bounced in Admin -> Emails. Only if IMAP is somewhere else:
# IMAP_HOST=  IMAP_PORT=993  IMAP_USER=  IMAP_PASS=   (IMAP_BOUNCES=off to stop)

# Billing is configured in the app: Admin -> Dodo Payments (test and live
# keys, mode switch) and Admin -> Plans. Keys saved there are encrypted with
# SETTINGS_SECRET - set it once and never change it.
SETTINGS_SECRET=
# Public URL of this API, shown in the admin panel as the webhook address.
# Production: PUBLIC_API_URL=https://api.widgetpop.com
PUBLIC_API_URL=http://localhost:3001
